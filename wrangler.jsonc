{
  // Assets-only Cloudflare Worker: serves the static site that the .NET generator writes to ./dist.
  // No Worker script is needed; Cloudflare serves the files from its edge.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Keep the custom domain in config so every deploy from CI preserves it.
  "routes": [
    { "pattern": "prajwalgiri.com.np", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
