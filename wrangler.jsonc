{
  // Assets-only Cloudflare Worker: serves the static site that the .NET generator writes to ./dist.
  // No Worker script is needed; Cloudflare serves the files from its edge.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true }

  // Custom domain: once prajwalgiri.com.np uses Cloudflare nameservers (a zone in this account),
  // add a comma after the observability line above and uncomment:
  // "routes": [
  //   { "pattern": "prajwalgiri.com.np", "custom_domain": true },
  //   { "pattern": "www.prajwalgiri.com.np", "custom_domain": true }
  // ]
}
