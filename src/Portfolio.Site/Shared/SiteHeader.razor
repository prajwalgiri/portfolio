<header class="site-header">
    <nav class="container nav" aria-label="Main">
        <a class="brand" href="/">
            <span class="monogram" aria-hidden="true">@Content.Person.Initials</span>
            <span>@Content.Person.Name</span>
        </a>
        <div class="nav-links">
            @if (Minimal)
            {
                <a href="/#work">Back to all work</a>
            }
            else
            {
                <a href="/#work">Work</a>
                <a href="/#about">About</a>
                <a href="/#experience">Experience</a>
                <a href="/#contact">Contact</a>
            }
            <a class="btn btn-accent press" href="@Content.Site.CvPdf">Download CV</a>
        </div>
    </nav>
</header>

@code {
    [Parameter, EditorRequired] public PortfolioContent Content { get; set; } = default!;
    [Parameter] public bool Minimal { get; set; }
}
